# Copy to .env (git-ignored) and adjust.

# glance.yml that Glaze edits. Relative paths start at the repository root.
GLAZE_CONFIG_PATH=.dev/glance.yml

# Port of the Glaze API (the web app proxies /api to it). Not plain PORT,
# because hosting tools often set that for other processes.
GLAZE_PORT=8090

# Optional: the Glance binary, used to run `glance config:validate` on drafts.
# Relative paths start at the repository root. Leave empty to skip this check.
# GLANCE_BIN=/usr/local/bin/glance

# Optional: where your browser can reach Glance, for the live preview.
# GLANCE_URL=http://localhost:8080

# ── Login ──

# Admin username. Default: admin.
# GLAZE_ADMIN_USERNAME=admin

# Admin password as a scrypt hash (preferred). Create one with
#   pnpm --filter server hash-password
# Since v0.1.1 hashes contain no $ signs, so no quotes are needed.
# (Fake example below; it matches no password.)
# GLAZE_ADMIN_PASSWORD_HASH=scrypt:32768:8:1:FAKEsaltReplaceMe0000w:FAKEhashRunHashPasswordAndPasteYourOwn00000

# Or the password in plain text (logs a warning at startup). The hash wins
# when both are set.
# GLAZE_ADMIN_PASSWORD=change-me-to-something-long

# Signs session cookies (at least 32 characters). When unset, Glaze creates
# one in <config folder>/.glaze/secret on first start.
# GLAZE_SECRET=

# Any of the three above can come from a file instead (Docker secrets):
# set <NAME>_FILE to its path. Setting both <NAME> and <NAME>_FILE is an error.
# GLAZE_ADMIN_PASSWORD_HASH_FILE=/run/secrets/glaze_password_hash
# GLAZE_ADMIN_PASSWORD_FILE=
# GLAZE_SECRET_FILE=

# true: Glaze runs behind a reverse proxy or Cloudflare Tunnel; read the
# client IP from CF-Connecting-IP / X-Forwarded-For and HTTPS from
# X-Forwarded-Proto. Leave off when Glaze is reached directly.
# GLAZE_TRUST_PROXY=false

# off: no login at all. Development only; refused when NODE_ENV=production.
# GLAZE_AUTH=off

# ── Asset files ──

# The folder (as Glaze sees it) with the files Glance serves under /assets/.
# Needed in Docker, where server.assets-path is a path inside the Glance
# container. Example: Glance mounts <config>/assets at /assets, Glaze mounts
# <config> at /config, so: GLAZE_ASSETS_PATH=/config/assets
# GLAZE_ASSETS_PATH=

# ── Production build ──

# Folder with the built web app. Default: apps/web/dist.
# GLAZE_WEB_DIST=apps/web/dist
