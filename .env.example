# Copy to .env (git-ignored) and adjust.

# glance.yml that Glaze edits. Relative paths start at the repository root.
GLAZE_CONFIG_PATH=.dev/glance.yml

# Port of the Glaze API (the web app proxies /api to it). Not plain PORT,
# because hosting tools often set that for other processes.
GLAZE_PORT=8090

# Optional: the Glance binary, used to run `glance config:validate` on drafts.
# Relative paths start at the repository root. Leave empty to skip this check.
# GLANCE_BIN=/usr/local/bin/glance

# Optional: where your browser can reach Glance, for the live preview.
# GLANCE_URL=http://localhost:8080
