{
	"name": "glaze",
	"version": "0.1.2",
	"description": "A visual editor for Glance dashboards",
	"private": true,
	"type": "module",
	"license": "MIT",
	"author": "Sean Klinge",
	"scripts": {
		"brand": "node scripts/brand.ts",
		"dev": "pnpm --parallel --filter \"./apps/*\" dev",
		"build": "pnpm -r --if-present build",
		"release:prepare": "node scripts/release.ts",
		"screenshots": "node scripts/screenshots.ts",
		"test": "pnpm -r --if-present test && pnpm test:scripts",
		"test:scripts": "node --test \"scripts/test/*.test.ts\"",
		"typecheck": "pnpm -r --if-present typecheck"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.15.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.15.0",
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@resvg/resvg-js": "^2.6.2",
		"playwright": "^1.64.1"
	}
}
